# =============================================================================
# Stubbed — environment variables. Copy to .env.local and fill what you need.
#
# ZERO variables set  → full DEMO MODE: bundled fixtures, local JSON store, local auth, no network.
# Keys present        → live providers switch on automatically (CATALOG_MODE/DATA_MODE = auto).
# Partial config      → the app refuses to boot (e.g. Supabase URL without anon key).
# Never commit real values. Only NEXT_PUBLIC_* values ever reach the browser.
# Nothing here posts to third parties: reviews and ratings live only in our DB (ADR-008).
# See docs/04-architecture/ADR-006-demo-fixture-mode.md.
# =============================================================================

# ---- Site -------------------------------------------------------------------
# Public base URL (OG tags, auth redirects, revalidate webhook target).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Inbox for the footer "Contact" link and "Report" on reviews (mailto). Public by design.
# Empty = the placeholder contact@example.com. Set it before launch.
NEXT_PUBLIC_CONTACT_EMAIL=

# ---- Mode selection (optional) ----------------------------------------------
# auto | fixtures | tmdb   — where title DETAIL comes from. auto = tmdb if a TMDB key is set.
CATALOG_MODE=auto
# auto | local | supabase  — where the INDEX + user data live. auto = supabase if URL + anon key set.
DATA_MODE=auto
# tmdb | off — "off" never requests image.tmdb.org and renders generated posters (offline/E2E).
IMAGE_MODE=tmdb

# ---- TMDB (catalogue source) — server only -----------------------------------
# Prefer the v4 "API Read Access Token" (Bearer). The v3 API key also works. One is enough.
TMDB_READ_TOKEN=
TMDB_API_KEY=

# ---- Curation rule (ADR-003) — server + sync job -----------------------------
CATALOG_MIN_RATING=6.5
CATALOG_MIN_VOTES_MOVIE=200
CATALOG_MIN_VOTES_TV=100
# Optional hysteresis: already-listed titles stay listed down to this rating (default = MIN_RATING = off).
CATALOG_KEEP_RATING=
# TMDB TV genres excluded from the catalogue (Talk, News, Reality). Empty = exclude none.
CATALOG_EXCLUDE_TV_GENRES=10767,10763,10764

# ---- Supabase (DB + Auth) ------------------------------------------------------
# Public by design (safe only because every table has RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Newer projects call the anon key a "publishable" key; either name works.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SERVER/JOB ONLY. Used by the nightly sync, catalogue cache writes and export. Never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---- On-demand revalidation (sync job → app) ---------------------------------
# Random string, e.g. `openssl rand -hex 32`. Required for POST /api/revalidate.
REVALIDATE_SECRET=

# ---- Rate limits (PRD E5). Live mode enforces 30/10 in Postgres triggers; these drive demo mode.
RATE_LIMIT_STUBS_PER_MIN=30
RATE_LIMIT_REVIEWS_PER_MIN=10

# ---- IMDb ratings via OMDb (ADR-008) — NIGHTLY JOB ONLY ------------------------
# The app never calls OMDb at request time: the nightly job caches imdb_rating/imdb_votes on
# catalog_index and every title payload returns them (null → the IMDb chip is hidden).
# Free key: https://www.omdbapi.com/apikey.aspx (1,000 calls/day, CC BY-NC).
# Without a key the job skips the IMDb step; demo fixtures already carry real IMDb ratings.
OMDB_API_KEY=
# Max OMDb calls per nightly run. Keep < 1000 on the free key. A paid key (OMDb Patreon) can go
# much higher; then lower OMDB_TTL_DAYS too. Order: never-checked titles, then the hot tier, then the rest.
OMDB_DAILY_BUDGET=900
# "Hot" tier = the N most popular listed titles, refreshed every OMDB_HOT_TTL_DAYS.
OMDB_HOT_COUNT=1000
OMDB_HOT_TTL_DAYS=7
# Everything else is refreshed every OMDB_TTL_DAYS (rolling; ~15k titles fit in ~900 calls/night).
OMDB_TTL_DAYS=30

# ---- Demo mode ------------------------------------------------------------------
# A PRODUCTION server (`next start`, Vercel) refuses to boot in demo mode unless this is true.
# Demo data resets and the demo accounts are shared: never present a demo URL as the product.
# With it on, magic-link dev links are only returned for the seeded @demo.stubbed.app accounts.
DEMO_MODE_PUBLIC=false
# seeded | any — which emails get a magic-link dev link in demo mode. Default: seeded in production,
# any in dev. `any` is for E2E only (playwright.config.ts): it lets anyone sign in as anyone.
DEMO_DEV_LINKS=
# HMAC key for the demo session cookie. A public fallback is used when empty (demo data only!).
DEMO_SESSION_SECRET=
# Where the demo JSON store lives. Default .data/demo (or /tmp/stubbed-demo on Vercel).
DEMO_DATA_DIR=
# file | memory — memory keeps demo data in RAM only (unit tests).
DEMO_PERSIST=file
# true = re-seed the demo store from fixtures at boot (E2E runs).
DEMO_RESET_ON_BOOT=false
# Fixed "today" (YYYY-MM-DD) for deterministic demos/E2E. Empty = real clock.
DEMO_TODAY=

# ---- Nightly sync guardrails (scripts/sync-catalog.ts) ----------------------------
# Minimum listed titles per type, else the run aborts with the index untouched. The first run on an
# empty catalogue only warns. `--dry-run` prints the real per-type counts: set these to ~80% of them.
SYNC_GUARD_MIN_MOVIE=3000
SYNC_GUARD_MIN_TV=1000
# Legacy single floor for both types (used only where the per-type value above is empty).
SYNC_GUARD_MIN=
SYNC_GUARD_MAX=25000
SYNC_GUARD_MAX_DELTA=0.2
# Enrich step ("Worth it?" + tickets): max TMDB detail calls per night, and re-enrich age in days.
SYNC_ENRICH_MAX=3000
SYNC_ENRICH_TTL_DAYS=30
# Region for age certifications (PG-13, TV-MA…). ISO 3166-1 alpha-2.
CERTIFICATION_REGION=US

# ---- E2E (playwright.config.ts) ---------------------------------------------------
# Point Playwright at an already-running server instead of building one.
E2E_BASE_URL=
E2E_PORT=3100

# ---- Observability (optional) --------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
