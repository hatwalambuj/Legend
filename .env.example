# =============================================================================
# Stubbed — environment variables. Copy to .env.local and fill what you need.
#
# ZERO variables set  → full DEMO MODE: bundled fixtures, local JSON store, local auth, no network.
# Keys present        → live providers switch on automatically (CATALOG_MODE/DATA_MODE = auto).
# Partial config      → the app refuses to boot (e.g. Supabase URL without anon key).
# Never commit real values. Only NEXT_PUBLIC_* values ever reach the browser.
# See docs/04-architecture/ADR-006-demo-fixture-mode.md.
# =============================================================================

# ---- Site -------------------------------------------------------------------
# Public base URL (OG tags, auth redirects, revalidate webhook target).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Mode selection (optional) ----------------------------------------------
# auto | fixtures | tmdb   — where title DETAIL comes from. auto = tmdb if a TMDB key is set.
CATALOG_MODE=auto
# auto | local | supabase  — where the INDEX + user data live. auto = supabase if URL + anon key set.
DATA_MODE=auto
# tmdb | off — "off" never requests image.tmdb.org and renders generated posters (offline/E2E).
IMAGE_MODE=tmdb

# ---- TMDB (catalogue source) — server only -----------------------------------
# Prefer the v4 "API Read Access Token" (Bearer). The v3 API key also works. One is enough.
TMDB_READ_TOKEN=
TMDB_API_KEY=

# ---- Curation rule (ADR-003) — server + sync job -----------------------------
CATALOG_MIN_RATING=6.5
CATALOG_MIN_VOTES_MOVIE=200
CATALOG_MIN_VOTES_TV=100
# Optional hysteresis: already-listed titles stay listed down to this rating (default = MIN_RATING = off).
CATALOG_KEEP_RATING=
# TMDB TV genres excluded from the catalogue (Talk, News, Reality). Empty = exclude none.
CATALOG_EXCLUDE_TV_GENRES=10767,10763,10764

# ---- Supabase (DB + Auth) ------------------------------------------------------
# Public by design (safe only because every table has RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Newer projects call the anon key a "publishable" key; either name works.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SERVER/JOB ONLY. Used by the nightly sync, catalogue cache writes and export. Never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---- On-demand revalidation (sync job → app) ---------------------------------
# Random string, e.g. `openssl rand -hex 32`. Required for POST /api/revalidate.
REVALIDATE_SECRET=

# ---- Rate limits (PRD E5). Live mode enforces 30/10 in Postgres triggers; these drive demo mode.
RATE_LIMIT_STUBS_PER_MIN=30
RATE_LIMIT_REVIEWS_PER_MIN=10

# ---- Optional: IMDb rating badge via OMDb (P1) ---------------------------------
OMDB_API_KEY=
FEATURE_OMDB_BADGE=false

# ---- v1: Trakt outbound sync (off by default, ADR-004) ------------------------
FEATURE_TRAKT_SYNC=false
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
TRAKT_REDIRECT_URI=
# 32-byte base64 key for AES-GCM encryption of stored OAuth tokens.
SYNC_TOKEN_ENC_KEY=

# ---- Demo mode ------------------------------------------------------------------
# HMAC key for the demo session cookie. A public fallback is used when empty (demo data only!).
DEMO_SESSION_SECRET=
# Where the demo JSON store lives. Default .data/demo (or /tmp/stubbed-demo on Vercel).
DEMO_DATA_DIR=
# file | memory — memory keeps demo data in RAM only (unit tests).
DEMO_PERSIST=file
# true = re-seed the demo store from fixtures at boot (E2E runs).
DEMO_RESET_ON_BOOT=false
# Fixed "today" (YYYY-MM-DD) for deterministic demos/E2E. Empty = real clock.
DEMO_TODAY=

# ---- Nightly sync guardrails (scripts/sync-catalog.ts) ----------------------------
SYNC_GUARD_MIN=5000
SYNC_GUARD_MAX=25000
SYNC_GUARD_MAX_DELTA=0.2

# ---- E2E (playwright.config.ts) ---------------------------------------------------
# Point Playwright at an already-running server instead of building one.
E2E_BASE_URL=
E2E_PORT=3100

# ---- Observability (optional) --------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
